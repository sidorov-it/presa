// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

type EmailPreferences {
  emailUpdates Boolean
}

type BackgroundSettings {
  backgroundColor String?
  backgroundImage String?
}

type GlobalHeaderFooterConfig {
  header Json
  footer Json
  applyTo String
}

enum BackgroundType {
  color
  image
}

enum Capitalization {
  none
  uppercase
}

enum ShadowSize {
  none
  sm
  md
}

enum BorderWidth {
  none
  thin
  medium
  thick
}

enum ImageShape {
  default
  fade
  diagonal
  round
  round_inverse
  wiggle
}

enum BackgroundBlockFillType {
  fill
  semi
  none
}

enum BlockFillColorsType {
  subtle
  primary
  custom
}

// enum BackgroundFillType {
//   fill
//   semi
//   none
// }

enum ButtonShape {
  square
  capsule
  default
  rounded
}

type PageBackground {
  type     BackgroundType
  color    String
  imageUrl String
}

model User {
  id                   String            @id @default(auto()) @map("_id") @db.ObjectId
  email                String            @unique
  passwordHash        String?           @map("password")
  name                 String
  image                String?
  isVerified           Boolean           @default(false)
  emailVerified        DateTime?
  verificationToken    String?
  verificationTokenExpires DateTime?
  role                 String            @default("user")
  createdVia           CreatedVia        @default(email)
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  emailPreferences     EmailPreferences?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  // Relationships
  presentations      Presentation[]
  themes             Theme[]
  llmRequests        LLMRequestHistory[]
  tokens             UserTokens?
  tokenPurchases     TokenPurchase[]
  tokenTransactions  TokenTransaction[]
  pdfGenerationTasks PdfGenerationTask[]
  oauthAccounts      OAuthAccount[]
  subscriptions      UserSubscription[]
}

enum CreatedVia {
  email
  vk
  ya
  mailru
}

model OAuthAccount {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @db.ObjectId
  provider      String
  providerUserId String
  accessToken   String
  refreshToken  String?
  tokenExpiresAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerUserId])
}

model Presentation {
  id                 String              @id @default(auto()) @map("_id") @db.ObjectId
  title              String
  description        String?
  durationMinutes    Int?
  goal               String?
  audience           String?
  tone               String?
  contentAmount      String?             @default("medium")
  slides             Json
  themeId            String?             @db.ObjectId
  userId             String              @db.ObjectId
  user               User                @relation(fields: [userId], references: [id])
  isDeleted          Boolean             @default(false)
  deletedAt          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  backgroundSettings BackgroundSettings?
  headerFooterConfig GlobalHeaderFooterConfig?
  llmRequests        LLMRequestHistory[]
  pdfGenerationTasks PdfGenerationTask[]
}

type ThemeColors {
  primaryAccent          String
  primaryAccentTextColor String?
  secondaryAccents       String[]       @default([])
  slideBackground        String
  pageBackground         PageBackground
}

type ThemeTypography {
  // Headings
  headingFont           String
  headingWeight         Float
  headingColor          String
  headingLineHeight     Float
  headingLetterSpacing  Float
  headingCapitalization Capitalization

  // Body Text
  bodyFont           String
  bodyWeight         Float
  bodyColor          String
  bodyLineHeight     Float
  bodyLetterSpacing  Float
  bodyCapitalization Capitalization
}

type ThemeSlide {
  borderRadius String
  shadow       ShadowSize
  borderWidth  BorderWidth
  borderColor  String
  opacity      Float
  // не используется
  imageShape   ImageShape?
}

type ThemeBlocks {
  backgroundColor             String
  backgroundBlockFillType     BackgroundBlockFillType
  borderWidth                 BorderWidth
  blockFillColorsType         BlockFillColorsType
  blockBackgroundCustomColors String[]
  shadow                      ShadowSize
}

type ThemeButtons {
  buttonColor String
  buttonShape ButtonShape
  linkColor   String
}

type ThemeDesign {
  // Slide Design
  slide ThemeSlide

  // Blocks and Content
  blocks ThemeBlocks

  // Buttons and Links
  buttons ThemeButtons
}

model Theme {
  id                         String          @id @default(auto()) @map("_id") @db.ObjectId
  name                       String
  description                String?
  logo                       String?
  colors                     ThemeColors
  typography                 ThemeTypography
  design                     ThemeDesign
  isDefault                  Boolean         @default(false)
  isActive                   Boolean         @default(true)
  defaultForNewPresentations Boolean         @default(false)
  userId                     String?         @db.ObjectId
  user                       User?           @relation(fields: [userId], references: [id])
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt
}

model LLMRequestHistory {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  userId         String?       @db.ObjectId
  user           User?         @relation(fields: [userId], references: [id])
  presentationId String?       @db.ObjectId
  presentation   Presentation? @relation(fields: [presentationId], references: [id])

  // Request details
  requestId   String? // Unique request ID for grouping related LLM calls
  provider    String
  requestType String // e.g. 'generate_slides', 'generate_image'
  prompt      String // Original prompt
  timestamp   DateTime @default(now())

  // Response metrics
  inputTokens  Int // Number of tokens in the prompt
  outputTokens Int // Number of tokens in the response
  totalTokens  Int // Total tokens used
  duration     Int // Request duration in ms
  cached       Boolean @default(false)

  // Cost tracking
  cost       Float // Cost in USD
  tokensUsed Int   @default(0) // Tokens deducted from user balance

  // Status
  success      Boolean @default(true)
  errorMessage String? // Error message if failed

  // Additional data
  metadata Json? // Any additional request/response data

  functionCall      String?
  functionArguments String?
  responseContent   String?

  @@index([requestId])
  @@index([userId])
  @@index([timestamp])
}

// Token system models
model UserTokens {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @unique @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  balance   Int      @default(0) // Current token balance
  totalUsed Int      @default(0) // Total tokens used historically
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TokenPackage {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  packageType String  @unique
  name        String // e.g. "Starter Pack", "Professional Pack"
  description String?
  tokens      Int // Number of tokens in the package
  price       Float // Price in USD
  currency    String  @default("RUB")
  isActive    Boolean @default(true)
  isPopular   Boolean @default(false) // For highlighting popular packages
  isHidden    Boolean @default(false) // For hiding packages from the UI

  purchases TokenPurchase[]
}

enum PurchaseStatus {
  pending
  completed
  failed
  refunded
  canceled
}

model TokenPurchase {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  userId      String       @db.ObjectId
  user        User         @relation(fields: [userId], references: [id])
  packageId   String       @db.ObjectId
  packageType String       @default("welcome")
  package     TokenPackage @relation(fields: [packageId], references: [id])

  // Purchase details
  tokensAmount Int
  price        Float
  currency     String         @default("USD")
  status       PurchaseStatus @default(pending)

  // Payment details
  paymentProvider   String?
  paymentId         String?
  sessionId         String?
  cloudpaymentsTxId String? // 🔸 больше не уникальное

  purchasedAt DateTime  @default(now())
  completedAt DateTime?

  metadata Json?
}

model TokenTransaction {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  // Transaction details
  amount      Int // Number of tokens (positive for credit, negative for debit)
  type        TransactionType
  description String // Description of the transaction

  // References
  purchaseId   String? // Reference to purchase if applicable
  llmRequestId String? @db.ObjectId // Reference to LLM request if applicable

  // Balance tracking
  balanceBefore Int // Token balance before transaction
  balanceAfter  Int // Token balance after transaction

  createdAt DateTime @default(now())
  metadata  Json? // Additional transaction data
}

enum TransactionType {
  purchase // Tokens added via purchase
  usage // Tokens used for LLM requests
  bonus // Free tokens given
  refund // Tokens refunded
  admin_adjustment // Manual adjustment by admin
}

enum PdfGenerationStatus {
  pending
  in_progress
  completed
  failed
}

model PdfGenerationTask {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  userId         String       @db.ObjectId
  user           User         @relation(fields: [userId], references: [id])
  presentationId String       @db.ObjectId
  presentation   Presentation @relation(fields: [presentationId], references: [id])

  // Task details
  status     PdfGenerationStatus @default(pending)
  slideIndex Int? // null for all slides, number for specific slide

  // Progress tracking
  totalSlides     Int @default(0)
  completedSlides Int @default(0)

  // File details
  fileName String? // Generated filename
  filePath String? // Path to generated file in public folder
  fileSize Int? // File size in bytes

  // Error handling
  errorMessage String? // Error message if failed

  // Timestamps
  createdAt   DateTime  @default(now())
  startedAt   DateTime? // When processing started
  completedAt DateTime? // When processing completed

  // Metadata
  metadata Json? // Additional task data
}

model CloudPaymentsWebhookLog {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt     DateTime @default(now())
  transactionId String
  invoiceId     String
  accountId     String
  status        String
  operationType String
  rawData       Json // Полный JSON-пакет от CloudPayments
  testMode      Boolean
}

// Subscription system models
enum SubscriptionInterval {
  monthly
  quarterly
  semiannual
  daily
}

enum SubscriptionStatus {
  active
  cancelled
  expired
  pending
  failed
  scheduled
}

model SubscriptionPlan {
  id          String               @id @default(auto()) @map("_id") @db.ObjectId
  name        String              // e.g. "Месячная подписка"
  description String?
  interval    SubscriptionInterval // monthly, quarterly, semiannual
  price       Float               // Price per billing cycle
  currency    String              @default("RUB")
  isActive    Boolean             @default(true)
  isPopular   Boolean             @default(false)
  
  // Features included in this plan
  features    Json?               // JSON object with plan features
  
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  
  subscriptions UserSubscription[]
  // @@unique([interval])
}

model UserSubscription {
  id               String             @id @default(auto()) @map("_id") @db.ObjectId
  userId           String             @db.ObjectId
  user             User               @relation(fields: [userId], references: [id])
  planId           String             @db.ObjectId
  plan             SubscriptionPlan   @relation(fields: [planId], references: [id])
  
  // Subscription details
  status           SubscriptionStatus @default(pending)
  startDate        DateTime
  endDate          DateTime
  nextBillingDate  DateTime?
  
  // Payment tracking
  cloudpaymentsId  String?           // CloudPayments subscription ID
  lastPaymentId    String?           // Reference to last successful payment
  
  // Cancellation tracking
  cancelledAt      DateTime?
  cancelReason     String?
  
  // Plan change tracking
  nextPlanId       String?           @db.ObjectId // References SubscriptionPlan for future plan change
  nextPlanStartDate DateTime?        // When the new plan should start
  
  // Metadata for additional data
  metadata         Json?
  
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  
  payments         SubscriptionPayment[]
  
  @@unique([userId, planId, status]) // User can have only one active subscription per plan
}

model SubscriptionPayment {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  subscriptionId   String           @db.ObjectId
  subscription     UserSubscription @relation(fields: [subscriptionId], references: [id])
  
  // Payment details
  amount           Float
  currency         String           @default("RUB")
  status           PurchaseStatus   @default(pending)
  
  // CloudPayments integration
  cloudpaymentsId  String?          // CloudPayments transaction ID
  cloudpaymentsTransactionId String? // CloudPayments transaction ID

  paymentMethod    String?          // Payment method used
  
  // Billing period this payment covers
  billingStart     DateTime
  billingEnd       DateTime?
  
  createdAt        DateTime         @default(now())
  completedAt      DateTime?
  
  metadata         Json?
}
