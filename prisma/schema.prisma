// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

type EmailPreferences {
  emailUpdates Boolean
}

type BackgroundSettings {
  backgroundColor String?
  backgroundImage String?
}

enum BackgroundType {
  color
  image
}

enum Capitalization {
  none
  uppercase
}

enum ShadowSize {
  none
  sm
  md
}

enum BorderWidth {
  none
  thin
  medium
  thick
}

enum ImageShape {
  default
  fade
  diagonal
  round
  round_inverse
  wiggle
}

enum BackgroundBlockFillType {
  fill
  semi
  none
}

enum BlockFillColorsType {
  subtle
  primary
  custom
}

// enum BackgroundFillType {
//   fill
//   semi
//   none
// }

enum ButtonShape {
  square
  capsule
  default
  rounded
}

type PageBackground {
  type     BackgroundType
  color    String
  imageUrl String
}

model User {
  id                   String            @id @default(auto()) @map("_id") @db.ObjectId
  email                String            @unique
  password             String
  name                 String
  image                String?
  isVerified           Boolean           @default(false)
  role                 String            @default("user")
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  emailPreferences     EmailPreferences?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  // Relationships
  presentations     Presentation[]
  themes            Theme[]
  llmRequests       LLMRequestHistory[]
  tokens            UserTokens?
  tokenPurchases    TokenPurchase[]
  tokenTransactions TokenTransaction[]
}

model Presentation {
  id                 String              @id @default(auto()) @map("_id") @db.ObjectId
  title              String
  description        String?
  durationMinutes    Int?
  goal               String?
  audience           String?
  tone               String?
  slides             Json
  themeId            String?             @db.ObjectId
  userId             String              @db.ObjectId
  user               User                @relation(fields: [userId], references: [id])
  isDeleted          Boolean             @default(false)
  deletedAt          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  backgroundSettings BackgroundSettings?
  llmRequests        LLMRequestHistory[]
}

type ThemeColors {
  primaryAccent          String
  primaryAccentTextColor String?
  slideBackground        String
  pageBackground         PageBackground
}

type ThemeTypography {
  // Headings
  headingFont           String
  headingWeight         Float
  headingColor          String
  headingLineHeight     Float
  headingLetterSpacing  Float
  headingCapitalization Capitalization

  // Body Text
  bodyFont           String
  bodyWeight         Float
  bodyColor          String
  bodyLineHeight     Float
  bodyLetterSpacing  Float
  bodyCapitalization Capitalization
}

type ThemeSlide {
  borderRadius String
  shadow       ShadowSize
  borderWidth  BorderWidth
  borderColor  String
  opacity      Float
  // не используется
  imageShape   ImageShape?
}

type ThemeBlocks {
  backgroundColor             String
  backgroundBlockFillType     BackgroundBlockFillType
  borderWidth                 BorderWidth
  blockFillColorsType         BlockFillColorsType
  blockBackgroundCustomColors String[]
  shadow                      ShadowSize
}

type ThemeButtons {
  buttonColor String
  buttonShape ButtonShape
  linkColor   String
}

type ThemeDesign {
  // Slide Design
  slide ThemeSlide

  // Blocks and Content
  blocks ThemeBlocks

  // Buttons and Links
  buttons ThemeButtons
}

model Theme {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  logo        String?
  colors      ThemeColors
  typography  ThemeTypography
  design      ThemeDesign
  isDefault   Boolean         @default(false)
  isActive    Boolean         @default(true)
  userId      String?         @db.ObjectId
  user        User?          @relation(fields: [userId], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model LLMRequestHistory {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  userId         String?       @db.ObjectId
  user           User?         @relation(fields: [userId], references: [id])
  presentationId String?       @db.ObjectId
  presentation   Presentation? @relation(fields: [presentationId], references: [id])

  // Request details
  requestType String // e.g. 'generate_slides', 'generate_image'
  prompt      String // Original prompt
  timestamp   DateTime @default(now())

  // Response metrics
  inputTokens  Int // Number of tokens in the prompt
  outputTokens Int // Number of tokens in the response
  totalTokens  Int // Total tokens used
  duration     Int // Request duration in ms
  cached       Boolean @default(false)

  // Cost tracking
  cost       Float // Cost in USD
  tokensUsed Int   @default(0) // Tokens deducted from user balance

  // Status
  success      Boolean @default(true)
  errorMessage String? // Error message if failed

  // Additional data
  metadata Json? // Any additional request/response data

  functionCall      String?
  functionArguments String?
  responseContent   String?
}

// Token system models
model UserTokens {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @unique @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  balance   Int      @default(0) // Current token balance
  totalUsed Int      @default(0) // Total tokens used historically
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TokenPackage {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String // e.g. "Starter Pack", "Professional Pack"
  description String?
  tokens      Int // Number of tokens in the package
  price       Float // Price in USD
  currency    String   @default("USD")
  isActive    Boolean  @default(true)
  isPopular   Boolean  @default(false) // For highlighting popular packages
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchases TokenPurchase[]
}

enum PurchaseStatus {
  pending
  completed
  failed
  refunded
  canceled
}

model TokenPurchase {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  userId    String       @db.ObjectId
  user      User         @relation(fields: [userId], references: [id])
  packageId String       @db.ObjectId
  package   TokenPackage @relation(fields: [packageId], references: [id])

  // Purchase details
  tokensAmount Int // Number of tokens purchased
  price        Float // Amount paid
  currency     String         @default("USD")
  status       PurchaseStatus @default(pending)

  // Payment details
  paymentProvider String? // e.g. "stripe", "paypal"
  paymentId       String? // External payment ID
  sessionId       String? // Payment session ID

  // Timestamps
  purchasedAt DateTime  @default(now())
  completedAt DateTime? // When the purchase was completed

  // Metadata
  metadata Json? // Additional payment data
}

model TokenTransaction {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  // Transaction details
  amount      Int // Number of tokens (positive for credit, negative for debit)
  type        TransactionType
  description String // Description of the transaction

  // References
  purchaseId   String? // Reference to purchase if applicable
  llmRequestId String? @db.ObjectId // Reference to LLM request if applicable

  // Balance tracking
  balanceBefore Int // Token balance before transaction
  balanceAfter  Int // Token balance after transaction

  createdAt DateTime @default(now())
  metadata  Json? // Additional transaction data
}

enum TransactionType {
  purchase // Tokens added via purchase
  usage // Tokens used for LLM requests
  bonus // Free tokens given
  refund // Tokens refunded
  admin_adjustment // Manual adjustment by admin
}
