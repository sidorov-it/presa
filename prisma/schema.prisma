// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

type EmailPreferences {
  emailUpdates Boolean
}

model User {
  id                  String         @id @default(auto()) @map("_id") @db.ObjectId
  email               String         @unique
  password            String
  name                String
  image               String?
  isVerified          Boolean        @default(false)
  role                String         @default("user")
  resetPasswordToken  String?
  resetPasswordExpires DateTime?
  emailPreferences    EmailPreferences?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  presentations       Presentation[]
}

model Presentation {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  slides      Json
  userId      String    @db.ObjectId
  user        User      @relation(fields: [userId], references: [id])
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

type ThemeColors {
  // Accent Colors
  primaryAccent      String
  secondaryAccents   String[]

  // Text Colors
  headingColor       String
  textColor          String

  // Background Colors
  slideBackground     String
  pageBackground     String
}

type ThemeTypography {
  // Headings
  headingFont        String
  headingWeight      Float
  headingColor       String

  // Body Text
  bodyFont           String
  bodyWeight         Float
  bodyColor          String
}

type ThemeSlide {
  borderRadius       String
  shadow             String
  border             String
  borderColor        String
  imageShape         String
}

type ThemeBlocks {
  backgroundColor    String
  opacity            Float
  borderWidth        String
  shadow             String
}

type ThemeButtons {
  buttonColor        String
  buttonShape        String
  linkColor          String
}

type ThemeDesign {
  // Slide Design
  slide              ThemeSlide
  
  // Blocks and Content
  blocks             ThemeBlocks
  
  // Buttons and Links
  buttons            ThemeButtons
}

model Theme {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  logo        String?
  colors      ThemeColors
  typography  ThemeTypography
  design      ThemeDesign
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
} 