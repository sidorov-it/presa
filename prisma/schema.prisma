// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

type EmailPreferences {
  emailUpdates Boolean
}

type BackgroundSettings {
  backgroundColor String?
  backgroundImage String?
}

enum BackgroundType {
  color
  image
}

enum Capitalization {
  none
  uppercase
}

enum ShadowSize {
  none
  sm
  md
}

enum BorderWidth {
  none
  thin
  medium
  thick
}

enum ImageShape {
  default
  fade
  diagonal
  round
  round_inverse
  wiggle
}

enum BackgroundFillType {
  fill
  semi
  none
}

enum BlockFillColorsType {
  subtle
  primary
  custom
}

enum ButtonShape {
  square
  capsule
  default
  rounded
}

type PageBackground {
  type     BackgroundType
  color    String
  imageUrl String
}

model User {
  id                   String            @id @default(auto()) @map("_id") @db.ObjectId
  email                String            @unique
  password             String
  name                 String
  image                String?
  isVerified           Boolean           @default(false)
  role                 String            @default("user")
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  emailPreferences     EmailPreferences?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  presentations        Presentation[]
  llmRequests          LLMRequestHistory[]
}

model Presentation {
  id                 String              @id @default(auto()) @map("_id") @db.ObjectId
  title              String
  description        String?
  slides             Json
  themeId            String?             @db.ObjectId
  userId             String              @db.ObjectId
  user               User                @relation(fields: [userId], references: [id])
  isDeleted          Boolean             @default(false)
  deletedAt          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  backgroundSettings BackgroundSettings?
  llmRequests        LLMRequestHistory[]
}

type ThemeColors {
  // Accent Colors
  primaryAccent    String
  additionalColors String[]
  secondaryAccents String[]
  shapesColor      String

  // Text Colors
  headingColor String
  textColor    String

  // Background Colors
  slideBackground String
  pageBackground  PageBackground

  // Additional Colors
  accentBlocksColor    String
  secondaryButtonColor String
}

type ThemeTypography {
  // Headings
  headingFont           String
  headingWeight         Float
  headingColor          String
  headingLineHeight     Float
  headingLetterSpacing  Float
  headingCapitalization Capitalization

  // Body Text
  bodyFont           String
  bodyWeight         Float
  bodyColor          String
  bodyLineHeight     Float
  bodyLetterSpacing  Float
  bodyCapitalization Capitalization
}

type ThemeSlide {
  borderRadius String
  shadow       ShadowSize
  borderWidth  BorderWidth
  borderColor  String
  opacity      Float
  imageShape   ImageShape
}

type ThemeBlocks {
  backgroundColor             String
  backgroundFillType          BackgroundFillType
  borderWidth                 BorderWidth
  blockFillColorsType         BlockFillColorsType
  blockBackgroundCustomColors String[]
  shadow                      ShadowSize
}

type ThemeButtons {
  buttonColor String
  buttonShape ButtonShape
  linkColor   String
}

type ThemeDesign {
  // Slide Design
  slide ThemeSlide

  // Blocks and Content
  blocks ThemeBlocks

  // Buttons and Links
  buttons ThemeButtons
}

model Theme {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  logo        String?
  colors      ThemeColors
  typography  ThemeTypography
  design      ThemeDesign
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model LLMRequestHistory {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  userId          String?       @db.ObjectId
  user            User?          @relation(fields: [userId], references: [id])
  presentationId  String?       @db.ObjectId
  presentation    Presentation? @relation(fields: [presentationId], references: [id])
  
  // Request details
  requestType     String        // e.g. 'generate_slides', 'generate_image'
  prompt          String        // Original prompt
  timestamp       DateTime      @default(now())
  
  // Response metrics
  inputTokens     Int          // Number of tokens in the prompt
  outputTokens    Int          // Number of tokens in the response
  totalTokens     Int          // Total tokens used
  duration        Int          // Request duration in ms
  cached          Boolean      @default(false)
  
  // Cost tracking
  cost            Float        // Cost in USD
  
  // Status
  success         Boolean      @default(true)
  errorMessage    String?      // Error message if failed
  
  // Additional data
  metadata        Json?        // Any additional request/response data

  functionCall      String?
  functionArguments String?
  responseContent   String?
}
