              },
              {
                "id": "v4po1xlyl9",
                "content": "<p><span class=\"body-text normal-text\" style=\"color: #ffffff\">Tell recipients how to read and comment on this memo</span><span class=\"body-text normal-text\" style=\"color: #ffffff\">&nbsp;</span></p>",
